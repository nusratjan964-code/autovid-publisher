{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/drive/download", "destination": "/api/drive/scan?download=1" },
    { "source": "/api/account", "destination": "/api/queue?action=account" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    }
  ]
}
